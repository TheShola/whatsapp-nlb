# ─────────────────────────────────────────────
#  Tin and Tain Bot — Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# ── Twilio ────────────────────────────────────
# https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Your Twilio WhatsApp sandbox number (or approved number in production)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Anthropic (Claude) ────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Paystack ──────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers
# Use sk_test_* for development, sk_live_* for production
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL Paystack redirects customer to after payment (optional)
PAYSTACK_CALLBACK_URL=https://yourdomain.com/payment-success

# ── Chowdeck ──────────────────────────────────
# https://chowdeck-api.readme.io — register as a merchant to get your key
CHOWDECK_API_KEY=your_chowdeck_api_key
# Found in your Chowdeck merchant dashboard under Settings
CHOWDECK_MERCHANT_REF=your_merchant_reference
# Webhook secret for verifying incoming Chowdeck events (set in Chowdeck dashboard)
CHOWDECK_WEBHOOK_SECRET=your_chowdeck_webhook_secret
# Full street address of your kitchen / fulfilment location in Lagos
PICKUP_ADDRESS=14 Admiralty Way, Lekki Phase 1, Lagos
# Phone number the rider can call at pickup
PICKUP_PHONE=+2348012345678
# Email for Chowdeck pickup contact
PICKUP_EMAIL=orders@tinandtain.com

# ── Airtable ───────────────────────────────────
# https://airtable.com/create/tokens → create a Personal Access Token
# Scopes needed: data.records:read, data.records:write
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Found in your base URL: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Exact name of your orders table in Airtable (case-sensitive)
AIRTABLE_ORDERS_TABLE=Orders

# ── Supabase ───────────────────────────────────
# https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Use the service_role key (not the anon key) — keep this secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX
# Local: redis://localhost:6379
# Railway/Render: injected automatically when you add the Redis plugin
REDIS_URL=redis://localhost:6379

# ── Redis ─────────────────────────────────────
# Local: redis://localhost:6379
# Railway/Render: injected automatically when you add the Redis plugin
REDIS_URL=redis://localhost:6379
